<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ExplorerPreview</AssemblyName>
    <RootNamespace>ExplorerPreview</RootNamespace>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
  </ItemGroup>

  <!--
    Bewusst KEINE <COMReference>-Einträge für SHDocVw/Shell32: die generierte
    ResolveComReference-Aufgabe wird von der .NET-Core-MSBuild-Version (die
    "dotnet build" nutzt) nicht unterstützt (MSB4803) - nur von der vollen
    .NET-Framework-MSBuild aus Visual Studio. SelectionWatcher.cs umgeht das
    komplett, indem es die Shell-COM-Objekte per ProgID + dynamic (Late-Binding)
    anspricht, ganz ohne generierte Interop-Assembly.
  -->

</Project>
