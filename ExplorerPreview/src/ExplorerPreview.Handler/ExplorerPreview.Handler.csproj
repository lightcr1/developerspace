<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>ExplorerPreview.Handler</RootNamespace>
    <AssemblyName>ExplorerPreview.Handler</AssemblyName>
    <Platforms>x64</Platforms>

    <!--
      Erzeugt beim Build eine native "*.comhost.dll" - das ist die Datei, die
      als InprocServer32 registriert wird (siehe scripts/Register-PreviewHandler.ps1).
      Dokumentiert unter https://learn.microsoft.com/dotnet/core/native-interop/expose-components-to-com
    -->
    <EnableComHosting>true</EnableComHosting>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExplorerPreview.Core\ExplorerPreview.Core.csproj" />
  </ItemGroup>

</Project>
